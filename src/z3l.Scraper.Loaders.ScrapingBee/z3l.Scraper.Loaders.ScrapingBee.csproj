<Project Sdk="Microsoft.NET.Sdk">

  <!-- shared settings and the version: ..\Directory.Build.props -->

  <PropertyGroup>
    <RootNamespace>z3l.Scraper.Loaders.ScrapingBee</RootNamespace>
    <AssemblyName>z3l.Scraper.Loaders.ScrapingBee</AssemblyName>
    <!-- not published yet: the package name is not chosen -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>z3l.Scraper.Loaders.ScrapingBee</PackageId>
    <Description>A page loader for z3l.Scraper through ScrapingBee: its proxies, browsers and captcha handling, called a page at a time within the plan's limit; a page that comes back blocked is loaded again with premium or stealth proxies.</Description>
    <PackageTags>scraper;web-scraping;crawler;scrapingbee;scraping-api;proxy;dotnet;net9;net10</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\z3l.Scraper\z3l.Scraper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="z3l.Scraper.Loaders.ScrapingBee.Tests" />
  </ItemGroup>

</Project>
