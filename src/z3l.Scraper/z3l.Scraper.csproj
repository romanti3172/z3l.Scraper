<Project Sdk="Microsoft.NET.Sdk">

  <!-- shared settings and the version: ..\Directory.Build.props -->

  <PropertyGroup>
    <RootNamespace>z3l.Scraper</RootNamespace>
    <AssemblyName>z3l.Scraper</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>z3l.Scraper</PackageId>
    <Description>Block-aware web scraping engine for .NET 9/10: request queue with priorities and de-duplication, retries with backoff, response checks (blocked, not found, cut-off pages), rotating http/socks proxies and user agents from a file or a URL with block policies, per-host throttling on 429/503, robots.txt, sitemaps, link depth, runs that resume after a crash, routing by page type or label with typed page data, async handlers and streamed results of any type. HTML is parsed with z3l.FastHtmlParser.</Description>
    <PackageTags>scraper;web-scraping;webscraping;crawler;web-crawler;crawling;spider;scraping;html;parser;retry;throttling;robots.txt;sitemap;proxy;dotnet;csharp;net9;net10</PackageTags>
    <Title>z3l Scraper</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="z3l.FastHtmlParser" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="z3l.Scraper.Tests" />
    <!-- the worker runs the response checks and sends text pages as text -->
    <InternalsVisibleTo Include="z3l.Scraper.RabbitMQ" />
  </ItemGroup>

</Project>
