  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\z3l.Scraper\z3l.Scraper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="z3l.Scraper.Loaders.ScraperApi.Tests" />
  </ItemGroup>

</Project>
