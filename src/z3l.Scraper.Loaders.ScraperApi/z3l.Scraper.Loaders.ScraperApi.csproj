<Project Sdk="Microsoft.NET.Sdk">

  <!-- shared settings and the version: ..\Directory.Build.props -->

  <PropertyGroup>
    <RootNamespace>z3l.Scraper.Loaders.ScraperApi</RootNamespace>
    <AssemblyName>z3l.Scraper.Loaders.ScraperApi</AssemblyName>
    <!-- not published yet: written from the documentation, not checked against the real API -->
